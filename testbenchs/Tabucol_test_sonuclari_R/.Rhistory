testbench <- data.frame(
klasor = c("DSJC", "DSJC", "DSJC", "DSJC", "flat", "le", "le", "le", "le"),
ad     = c("DSJC125.1", "DSJC125.5", "DSJC125.9", "DSJC250.1",
"flat300_20_0", "le450_15a", "le450_15b", "le450_25a", "le450_25b")
)
oku <- function(klasor, ad) {
yol <- glue("../{klasor}/performans_testleri/{ad}/{ad}")
bind_rows(
read.csv(glue("{yol}_C_multi.csv")) |>  mutate(mode = "C", data = ad),
read.csv(glue("{yol}_bitbase_multi.csv")) |>  mutate(mode = "bitbase", data = ad)
)
}
multi_performans_tests <- setNames(
Map(oku, testbench$klasor, testbench$ad),
testbench$ad
)
names(multi_performans_tests)
ready_multi_performans <- bind_rows(multi_performans_tests)
write.csv(ready_multi_performans, "Tables/Multi_performans_test.csv")
oku <- function(klasor, ad) {
yol <- glue("../{klasor}/performans_testleri/{ad}/{ad}")
bind_rows(
read.csv(glue("{yol}_C_single.csv")) |>  mutate(mode = "C", data = ad),
read.csv(glue("{yol}_bitbase_single.csv")) |>  mutate(mode = "bitbase", data = ad)
)
}
single_performans_tests <- setNames(
Map(oku, testbench$klasor, testbench$ad),
testbench$ad
)
names(single_performans_tests)
ready_single_performans <- bind_rows(single_performans_tests)
write.csv(ready_single_performans, "Tables/Single_performans_test.csv")
plot_tabu_performance_by_group <- function(df,
x_col,
y_col,
group_col,
title = "DSJC250.5 Graph — Tabu Tenure vs Fs",
subtitle = "Performance comparison across replications",
filename = NULL,
width = 10,
height = 6,
dpi = 300,
x_angle = 0
) {
p <- df |>
mutate(..group = as.factor({{ group_col }})) |>
ggplot(aes(x = {{ x_col }}, y = {{ y_col }}, color = ..group, fill = ..group)) +
geom_area(alpha = 0.08, position = "identity") +
geom_line(linewidth = 1.1) +
geom_point(size = 2, alpha = 0.8) +
coord_cartesian(clip = "off") +
#scale_x_continuous(breaks = scales::pretty_breaks(n = 8)) +
scale_y_continuous(labels = scales::number_format(accuracy = 0.01)) +
# High-contrast color palette for dark background
scale_color_manual(values = c("#00adb5", "#ff007f", "#00ff88", "#f9e2af", "#cba6f7", "#89b4fa")) +
scale_fill_manual(values = c("#00adb5", "#ff007f", "#00ff88", "#f9e2af", "#cba6f7", "#89b4fa")) +
theme_minimal(base_family = "sans") +
theme(
plot.background = element_rect(fill = "#1e1e2e", color = NA),
panel.background = element_rect(fill = "#181825", color = NA),
panel.grid.major = element_line(color = "#313244", linewidth = 0.4),
panel.grid.minor = element_blank(),
text = element_text(color = "#cdd6f4"),
axis.text = element_text(color = "#bac2de"),
axis.title = element_text(color = "#cdd6f4", face = "bold"),
plot.title = element_text(color = "#00ff88", face = "bold", size = 13),
plot.subtitle = element_text(color = "#a6adc8", size = 10),
plot.margin = margin(t = 15, r = 30, b = 15, l = 20),
axis.text.x = element_text(angle = x_angle, hjust = if (x_angle > 0) 1 else 0.5),
# Legend customization
legend.position = "top",
legend.background = element_rect(fill = "#181825", color = NA),
legend.key = element_rect(fill = "#181825", color = NA),
legend.text = element_text(color = "#cdd6f4"),
legend.title = element_text(color = "#00ff88", face = "bold")
) +
labs(
title = title,
subtitle = subtitle,
x = rlang::as_name(rlang::enquo(x_col)),
y = rlang::as_name(rlang::enquo(y_col)),
color = rlang::as_name(rlang::enquo(group_col)),
fill = rlang::as_name(rlang::enquo(group_col))
)
# Save plot if a filename path is provided
if (!is.null(filename)) {
ggsave(
filename = filename,
plot = p,
width = width,
height = height,
dpi = dpi,
bg = "#1e1e2e" # Ensures dark background is retained in saved file
)
}
# Return the ggplot object so it renders in RStudio/Console
return(p)
}
ready_single_performans |>
group_by(data, mode) |>
summarise(Avg_Fs = mean(Fs, na.rm = TRUE), .groups = "drop") |>
plot_tabu_performance_by_group(
x_col     = data,
y_col     = Avg_Fs,
group_col = mode,
x_angle   = 45,
title     = "Testbench Performans Karşılaştırması — C vs Bitbase",
subtitle  = "Testbench / Ortalama Fs Performans Eğrisi",
filename  = "Performans_Testleri/Testbench_Avg_Fs_C_vs_Bitbase.png"
)
ready_single_performans |>
group_by(data, mode) |>
summarise(Avg_Solve_Time = mean(Solve_time, na.rm = TRUE), .groups = "drop") |>
plot_tabu_performance_by_group(
x_col     = data,
y_col     = Avg_Solve_Time,
group_col = mode,
x_angle   = 45,
title     = "Testbench Performans Karşılaştırması — C vs Bitbase",
subtitle  = "Testbench / Ortalama Fs Performans Eğrisi",
filename  = "Performans_Testleri/Testbench_Avg_Fs_C_vs_Bitbase.png"
)
plot_tabu_performance_by_group <- function(df,
x_col,
y_col,
group_col,
title = "DSJC250.5 Graph — Tabu Tenure vs Fs",
subtitle = "Performance comparison across replications",
filename = NULL,
width = 10,
height = 6,
dpi = 300,
x_angle = 0,
y_trans = "identity"
) {
p <- df |>
mutate(..group = as.factor({{ group_col }})) |>
ggplot(aes(x = {{ x_col }}, y = {{ y_col }}, color = ..group, fill = ..group, group = ..group)) +
geom_area(alpha = 0.08, position = "identity") +
geom_line(linewidth = 1.1) +
geom_point(size = 2, alpha = 0.8) +
coord_cartesian(clip = "off") +
scale_y_continuous(trans = y_trans, labels = scales::number_format(accuracy = 0.01)) +
# High-contrast color palette for dark background
scale_color_manual(values = c("#00adb5", "#ff007f", "#00ff88", "#f9e2af", "#cba6f7", "#89b4fa")) +
scale_fill_manual(values = c("#00adb5", "#ff007f", "#00ff88", "#f9e2af", "#cba6f7", "#89b4fa")) +
theme_minimal(base_family = "sans") +
theme(
plot.background = element_rect(fill = "#1e1e2e", color = NA),
panel.background = element_rect(fill = "#181825", color = NA),
panel.grid.major = element_line(color = "#313244", linewidth = 0.4),
panel.grid.minor = element_blank(),
text = element_text(color = "#cdd6f4"),
axis.text = element_text(color = "#bac2de"),
axis.title = element_text(color = "#cdd6f4", face = "bold"),
plot.title = element_text(color = "#00ff88", face = "bold", size = 13),
plot.subtitle = element_text(color = "#a6adc8", size = 10),
plot.margin = margin(t = 15, r = 30, b = 15, l = 20),
axis.text.x = element_text(angle = x_angle, hjust = if (x_angle > 0) 1 else 0.5),
# Legend customization
legend.position = "top",
legend.background = element_rect(fill = "#181825", color = NA),
legend.key = element_rect(fill = "#181825", color = NA),
legend.text = element_text(color = "#cdd6f4"),
legend.title = element_text(color = "#00ff88", face = "bold")
) +
labs(
title = title,
subtitle = subtitle,
x = rlang::as_name(rlang::enquo(x_col)),
y = rlang::as_name(rlang::enquo(y_col)),
color = rlang::as_name(rlang::enquo(group_col)),
fill = rlang::as_name(rlang::enquo(group_col))
)
# Save plot if a filename path is provided
if (!is.null(filename)) {
ggsave(
filename = filename,
plot = p,
width = width,
height = height,
dpi = dpi,
bg = "#1e1e2e" # Ensures dark background is retained in saved file
)
}
# Return the ggplot object so it renders in RStudio/Console
return(p)
}
ready_single_performans |>
group_by(data, mode) |>
summarise(Avg_Fs = mean(Fs, na.rm = TRUE), .groups = "drop") |>
plot_tabu_performance_by_group(
x_col     = data,
y_col     = Avg_Fs,
group_col = mode,
x_angle   = 45,
y_trans   = "sqrt",
title     = "Testbench Performans Karşılaştırması — C vs Bitbase",
subtitle  = "Testbench / Ortalama Fs Performans Eğrisi",
filename  = "Performans_Testleri/Testbench_Avg_Fs_C_vs_Bitbase.png"
)
ready_single_performans |>
group_by(data, mode) |>
summarise(Avg_Solve_Time = mean(Solve_time, na.rm = TRUE), .groups = "drop") |>
plot_tabu_performance_by_group(
x_col     = data,
y_col     = Avg_Solve_Time,
group_col = mode,
x_angle   = 45,
y_trans   = "sqrt",
title     = "Testbench Performans Karşılaştırması — C vs Bitbase",
subtitle  = "Testbench / Ortalama Çözüm Süresi Karşılaştırma Eğrisi",
filename  = "Performans_Testleri/Testbench_Avg_Solve_Time_C_vs_Bitbase.png"
)
testbench_summary <- ready_single_performans |>
group_by(data, mode) |>
summarise(Avg_Solve_time = mean(Solve_time, na.rm = TRUE), .groups = "drop")
testbench_ratio_labels <- testbench_summary |>
pivot_wider(names_from = mode, values_from = Avg_Solve_time) |>
mutate(
ratio       = round(C / bitbase, 2),
ratio_label = ifelse(is.finite(ratio), paste0("×", ratio), "—"),
label_y     = pmax(C, bitbase, na.rm = TRUE)
) |>
select(data, ratio_label, label_y)
testbench_summary |>
plot_tabu_performance_by_group(
x_col     = data,
y_col     = Avg_Solve_time,
group_col = mode,
x_angle   = 45,
y_trans   = "sqrt",
title     = "Testbench Performans Karşılaştırması — C vs Bitbase",
subtitle  = "Testbench / Ortalama Çözüm Süresi | Etiket: C/Bitbase Hız Oranı",
filename  = "Performans_Testleri/Testbench_Avg_Solve_Time_C_vs_Bitbase.png"
) +
geom_label(
data          = testbench_ratio_labels,
aes(x = data, y = label_y, label = ratio_label),
inherit.aes   = FALSE,
vjust         = -0.4,
color         = "#f9e2af",
fill          = "#313244",
size          = 3,
fontface      = "bold",
label.size    = 0.3,
label.padding = unit(0.15, "lines")
)
View(testbench_ratio_labels)
View(testbench_summary)
